# ══════════════════════════════════════════════
# Configuration Environment Variables
# ══════════════════════════════════════════════
# Copier ce fichier vers .env et adapter les valeurs

# ══════════════════════════════════════════════
# CONFIG SERVER — Repo GitHub public (m2-miage-msa-odoru)
# ══════════════════════════════════════════════
CONFIG_GIT_URI=https://github.com/m2-miage-msa-odoru/config.git
CONFIG_SEARCH_PATHS=.
CONFIG_GIT_BRANCH=main
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=

# ══════════════════════════════════════════════
# POSTGRESQL — Conteneur (admin du serveur PG)
# ══════════════════════════════════════════════
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=msuser

# ══════════════════════════════════════════════
# MS-USER — Connexion à sa base
# ══════════════════════════════════════════════
MS_USER_DB=msuser
MS_USER_DB_USERNAME=user
MS_USER_DB_PASSWORD=password

# ══════════════════════════════════════════════
# MS-BADGE — Base PostgreSQL dédiée
# ══════════════════════════════════════════════
MS_BADGE_DB=msbadge
MS_BADGE_DB_USERNAME=badge
MS_BADGE_DB_PASSWORD=badge

# ══════════════════════════════════════════════
# RABBITMQ
# ══════════════════════════════════════════════
RABBITMQ_USER=msuser_admin
RABBITMQ_PASSWORD=msuser_mdp

# ══════════════════════════════════════════════
# EUREKA
# ══════════════════════════════════════════════
EUREKA_URL=http://eureka-server:8761/eureka/
